# Mercury Observatory sidecar — systemd USER unit template.
# Rendered by observatory.config_gen.render_sidecar_unit (pure string
# templating, same law as config_gen.render_homeserver_unit; re-exported
# from sidecar_main for back-compat). Placeholders:
#   {description} {python_bin} {hermes_root} {mercury_home} {log_dir}
#   {hermes_home} {mercury_config} {agent_dir} {omp_bin} {sane_path} {venv_dir}
# Installed as ~/.config/systemd/user/mercury-observatory.service; the
# homeserver has its own unit (mercury-observatory-homeserver.service,
# config_gen.render_homeserver_unit) which this one orders after.
# Env mirrors mercury-gateway.service (mercury_cli.gateway.generate_systemd_unit):
# the sidecar must resolve the unified MERCURY_CONFIG (not HERMES_HOME/config.yaml),
# so approvals + model.default survive outside a login shell.
[Unit]
Description={description}
Wants=mercury-observatory-homeserver.service
After=mercury-observatory-homeserver.service
StartLimitIntervalSec=0

[Service]
Type=simple
# The sidecar owns ALL matrix I/O (spec D3) — one process, its own venv
# interpreter, PYTHONPATH at the hermes engine root.
ExecStart={python_bin} -m observatory.sidecar_main --home {mercury_home}
WorkingDirectory={hermes_root}
Environment="PATH={sane_path}"
Environment="VIRTUAL_ENV={venv_dir}"
Environment="HERMES_HOME={hermes_home}"
Environment="MERCURY_HOME={mercury_home}"
Environment="MERCURY_CONFIG={mercury_config}"
Environment="PI_CODING_AGENT_DIR={agent_dir}"
Environment="HERMES_OMP_BIN={omp_bin}"
Environment=PYTHONPATH={hermes_root}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:{log_dir}/sidecar.log
StandardError=append:{log_dir}/sidecar.log

[Install]
WantedBy=default.target
